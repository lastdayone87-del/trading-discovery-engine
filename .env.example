# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Quota-fate labels (OPTIONAL — each key slot is an independent Gemini
# account/quota pool by default): GEMINI_ORG_ID (+ GEMINI_ORG_ID_2..N matching
# the key slots) only needs setting to declare the quota identity. Keys from
# separate Google Cloud projects have independent quotas; unlabeled slots use
# independent slot-N defaults, or name them gemini-project-1..N for readability.
# Labels are only needed to group key slots that share one project/account:
# set the SAME label on those slots. Identical labels mean the keys share one
# account: a 429 cools all of them and never fails over between them.
# Different (or slot-default) labels mean independent accounts.
# GEMINI_ORG_ID=""
# GEMINI_API_KEY_2=""
# GEMINI_ORG_ID_2=""

# YouTube pool size is configuration-driven. The production default supports
# 30 keys (YOUTUBE_API_KEY plus YOUTUBE_API_KEY_1 through _29).
YOUTUBE_API_KEY_POOL_SIZE="30"
YOUTUBE_API_KEY=""
YOUTUBE_API_KEY_1=""
YOUTUBE_API_KEY_2=""
YOUTUBE_API_KEY_3=""
YOUTUBE_API_KEY_4=""
YOUTUBE_API_KEY_5=""
YOUTUBE_API_KEY_6=""
YOUTUBE_API_KEY_7=""
YOUTUBE_API_KEY_8=""
YOUTUBE_API_KEY_9=""
YOUTUBE_API_KEY_10=""
YOUTUBE_API_KEY_11=""
YOUTUBE_API_KEY_12=""
YOUTUBE_API_KEY_13=""
YOUTUBE_API_KEY_14=""
YOUTUBE_API_KEY_15=""
YOUTUBE_API_KEY_16=""
YOUTUBE_API_KEY_17=""
YOUTUBE_API_KEY_18=""
YOUTUBE_API_KEY_19=""
YOUTUBE_API_KEY_20=""
YOUTUBE_API_KEY_21=""
YOUTUBE_API_KEY_22=""
YOUTUBE_API_KEY_23=""
YOUTUBE_API_KEY_24=""
YOUTUBE_API_KEY_25=""
YOUTUBE_API_KEY_26=""
YOUTUBE_API_KEY_27=""
YOUTUBE_API_KEY_28=""
YOUTUBE_API_KEY_29=""

# Daily capacity per configured key. Total capacity is derived from the unique
# key pool (30 keys x 10,000 units = 300,000 units at the default pool size).
# P0 project/quota map (CORE infrastructure): YouTube quota is per Cloud
# project, not per key. Keys sharing one Google Cloud project MUST share one
# YOUTUBE_API_KEY*_QUOTA_GROUP label (e.g. YOUTUBE_API_KEY_QUOTA_GROUP=project-a
# and YOUTUBE_API_KEY_1_QUOTA_GROUP=project-a). Distinct projects use distinct
# labels. Keys without a label retain legacy per-key assumption for backwards
# compatibility. Effective budget = (distinct projects + ungrouped keys) x
# YOUTUBE_DAILY_QUOTA_PER_KEY. Search bucket default is ~100 search.list/day
# per project; pooling keys in one project does not multiply searches.
# Example:
# YOUTUBE_API_KEY_QUOTA_GROUP="google-project-1"
# YOUTUBE_API_KEY_1_QUOTA_GROUP="google-project-1"
# YOUTUBE_API_KEY_2_QUOTA_GROUP="google-project-2"
YOUTUBE_DAILY_QUOTA_PER_KEY="10000"
# Pool circuit breaker. After every project reports quotaExceeded, one caller
# probes after this delay; repeated exhaustion doubles the delay up to the max.
YOUTUBE_POOL_BACKOFF_MS="900000"
YOUTUBE_POOL_MAX_BACKOFF_MS="21600000"
# Process-wide outbound pacing plus per-provider rate-limit cooldown. A provider
# reporting rateLimitExceeded is skipped while healthy configured keys are tried.
YOUTUBE_MIN_REQUEST_INTERVAL_MS="250"
YOUTUBE_RATE_LIMIT_BACKOFF_MS="5000"
YOUTUBE_RATE_LIMIT_MAX_BACKOFF_MS="300000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PostgreSQL runtime. Required in production and for Phase 1 PostgreSQL migration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Set to disable only for local Postgres instances that do not use SSL.
# PGSSL="disable"

# Railway injects PORT at runtime. Local fallback is 3000.
PORT="3000"
# Comma-separated extra Vite hostnames. Host validation remains enabled. The
# canonical Railway hostname is included by default.
VITE_ALLOWED_HOSTS=""

# Logging level for production diagnostics.
LOG_LEVEL="info"

# Query Intelligence diversity controls. Values in app_settings override these defaults.
QUERY_INTELLIGENCE_COOLDOWN_MINUTES="360"
QUERY_INTELLIGENCE_PRIMARY_TERM_MAX_USES="2"
QUERY_INTELLIGENCE_EXPLORATION_RATIO="0.4"

# Continuous discovery producer and quota allocations. PostgreSQL app_settings
# with matching lowercase keys override these values at runtime.
DISCOVERY_INTERVAL_MINUTES="5"
DISCOVERY_BATCH_SIZE="5"
DISCOVERY_TARGET_QUEUE_DEPTH="30"
DISCOVERY_AUTONOMOUS_QUOTA_PERCENT="70"
DISCOVERY_ENRICHMENT_QUOTA_PERCENT="10"
DISCOVERY_MANUAL_QUOTA_PERCENT="20"
# Phase 0 queue clock. Default false preserves legacy behavior: created_at is
# the FIFO/queue-age key and capacity renewals rewrite it. Enable only after
# migration 162 is live and the capacity-lease canary is reviewed.
ACQUISITION_JOB_CLOCK_V2_ENABLED="false"
# Phase 2 Option C: persist one append-only acquisition_lane_events row per
# inspection so crawls/hour, gate wait, and the discovery share are measurable.
# The writer is observational only and can never change an acquisition result.
# The production image enables this; the local/test default stays off.
ACQUISITION_LANE_TELEMETRY_ENABLED="false"
SEARCH_WORKER_CONCURRENCY="4"
MANUAL_SEARCH_WORKER_CONCURRENCY="1"
# 3 enrichment workers: measured ~334s mean service demand per completion
# (~10.8/hr per worker). RENDERED_FALLBACK_CONCURRENCY stays 1 because the
# process-wide browser runtime lease serializes crawler runs anyway — a
# higher gate would only burn waiter timeout budgets. Both remain
# env-overridable; allocation percents below are accounting-only.
ENRICHMENT_WORKER_CONCURRENCY="3"
# Phase 4 measured scale gate. A request above 3 is clamped back to 3 unless
# the durable semantic ledger shows success >90%, p95 <30s, and stable ENRICH
# backlog. Set ENRICHMENT_SCALE_GATE_ENABLED="false" only for an operator-led
# rollback; the gate never raises concurrency above 6.
ENRICHMENT_SCALE_GATE_ENABLED="true"
# ENRICHMENT_SCALE_MIN_SUCCESS_RATE="0.9"
# ENRICHMENT_SCALE_MAX_P95_MS="30000"
# ENRICHMENT_SCALE_MIN_SAMPLE="50"
# ENRICHMENT_SCALE_MAX_PENDING="500"
# ENRICHMENT_SCALE_MIN_COMPLETION_RATIO="0.9"
# Startup never waits longer than this for the scale metrics; a timeout falls
# back to the 3-worker baseline rather than leaving workers stopped.
# ENRICHMENT_SCALE_METRICS_TIMEOUT_MS="5000"
RENDERED_FALLBACK_CONCURRENCY="1"
# Phase 2 Option C single-slot admission governor. The production image enables
# it explicitly; local/CI default off to avoid throttling deterministic harnesses.
# 40/h nominal, 48/h emergency only when the nominal window is full and another
# rendered request is queued, 35% DISCOVERY floor whenever discovery is queued.
RENDERED_ADMISSION_GOVERNOR_ENABLED="false"
RENDERED_ADMISSION_NOMINAL_PER_HOUR="40"
RENDERED_ADMISSION_EMERGENCY_PER_HOUR="48"
RENDERED_ADMISSION_DISCOVERY_FLOOR_PCT="35"
# Max time a rendered request may wait for the single browser slot before it is
# deferred as capacity (attempt-free). The per-crawl total budget remains 60s.
RENDERED_FALLBACK_MAX_WAIT_MS="90000"
# Phase 3 search/classification decoupling. ON is the default: search workers
# persist a nomination plus an insert-only provisional row and enqueue
# CLASSIFY_DISCOVERED_CHANNEL; two of the three enrichment workers claim
# classifications first while one keeps draining the pre-existing
# ENRICH_CHANNEL backlog. Set the flag to "false" to roll back to the exact
# legacy inline channel loop. The caps apply at admission; at either cap the
# page processes the channel inline instead of dropping it.
SEARCH_CLASSIFICATION_DECOUPLING_ENABLED="true"
CLASSIFY_DISCOVERED_CHANNEL_MAX_PENDING="500"
CLASSIFY_DISCOVERED_CHANNEL_MAX_PER_QUERY="50"
# Priority 15 outranks the default ENRICH priority (10) without overtaking
# search continuations/operator work. Max attempts covers classification plus
# bounded first-enrichment retries.
CLASSIFY_DISCOVERED_CHANNEL_PRIORITY="15"
CLASSIFY_DISCOVERED_CHANNEL_MAX_ATTEMPTS="4"
YOUTUBE_DISCOVERY_MAX_RESULTS="25"
# Phase 2 deadline rollout starts disabled. Enable per environment after observing
# p99 latency; both timeout values remain independently tunable.
PROVIDER_DEADLINES_ENABLED="false"
YOUTUBE_PROVIDER_TIMEOUT_MS="30000"
GEMINI_PROVIDER_TIMEOUT_MS="45000"
DISCORD_PROVIDER_TIMEOUT_MS="15000"
# Groq semantic shadow integration (opt-in only; nothing runs without keys).
# GROQ_API_KEY (+ GROQ_API_KEY_2..N for route failover) enables the Groq
# semantic provider. Published free-tier envelope for openai/gpt-oss-120b is
# 30 RPM / 8K TPM / 1K RPD / 200K TPD — pace shadow runs accordingly.
GROQ_API_KEY=""
# GROQ_API_KEY_2=""
# Quota-fate labels (OPTIONAL for Groq — each key slot is an independent
# account by default): GROQ_ORG_ID (+ GROQ_ORG_ID_2..N matching the key slots)
# only needs setting to declare that several keys share one Groq
# organization/quota pool. Production startup does NOT require GROQ_ORG_ID.
# Identical labels mean the keys share one org: a 429 cools all of them and
# never fails over between them. Different (or slot-default) labels mean
# independent orgs: a 429 cools only its own org and fails over to the next
# healthy org. Only set the SAME label on slots whose keys truly belong to
# one org.
# GROQ_ORG_ID=""
# GROQ_API_KEY_2=""
# GROQ_ORG_ID_2=""
GROQ_CANDIDATE_MODEL="openai/gpt-oss-120b"
GROQ_ADJUDICATOR_MODEL="openai/gpt-oss-120b"
GROQ_PROVIDER_TIMEOUT_MS="135000"
GROQ_MAX_COMPLETION_TOKENS="800"
# A key rejected with Groq `organization_restricted` is quarantined in-process
# for this TTL; other independent orgs keep serving. Default one hour.
# GROQ_RESTRICTED_ROUTE_TTL_MS="3600000"
# Invalid/missing model JSON repeats across accounts at temperature 0. Stop
# after this many routes and let the caller use its deterministic fallback.
# GROQ_JSON_VALIDATION_MAX_ROUTES="2"
# Semantic prompt budget (free tier is 8K tokens/minute). Every field
# reference is preserved; only document text is shortened. The token budget is
# script-aware: non-ASCII text can approach one token per character.
# GROQ_MAX_PROMPT_CHARS="24000"
# GROQ_MAX_PROMPT_TOKENS="6000"
# GROQ_REASONING_EFFORT="" (unset by default; unsupported values 400 on some models)
# SEMANTIC_PROVIDER="groq" selects Groq; SEMANTIC_PROVIDER="gemini-free" selects
# the independent free-tier Gemini setup; unset (or anything else) keeps the
# paid Gemini setup. The free and Groq selectors are mutually exclusive.
SEMANTIC_PROVIDER=""
# Independent free-tier Gemini classifier (Google AI Studio free tier,
# default gemini-2.5-flash-lite). Completely separate keys, routes, provider
# identity, and cooldown ledger from the paid GEMINI_API_KEY setup above:
# the two setups never share quota, never fall back to each other, and are
# never compared. Free-tier envelope is roughly 15 RPM / 1500 RPD on Flash.
GEMINI_FREE_API_KEY=""
# GEMINI_FREE_API_KEY_2=""
GEMINI_FREE_CANDIDATE_MODEL="gemini-2.5-flash-lite"
GEMINI_FREE_ADJUDICATOR_MODEL="gemini-2.5-flash-lite"
# GEMINI_FREE_ADJUDICATION_ENABLED="true" enables the low-confidence second pass.
GEMINI_FREE_PROVIDER_TIMEOUT_MS="135000"
# GEMINI_FREE_RATE_LIMIT_COOLDOWN_MS="90000"
# YouTube.js (InnerTube) discovery provider: quota-free, no API key required.
# Fully ACTIVE alongside the official YouTube Data API v3 path with its own
# session, pacing, cooldown, and telemetry (provider='youtube-innertube').
# YOUTUBE_INNERTUBE_TIMEOUT_MS="30000"
# YOUTUBE_INNERTUBE_COOLDOWN_MS="90000"
# SEMANTIC_PROVIDER_FORCE_GEMINI="true" is the immediate kill switch back to Gemini.
#
# Phase 4 semantic scale controls (all safe defaults):
# - Result cache: final semantic verdict keyed by evidence checksum + prompt/
#   feature/model versions. Fail-open; set false to bypass reads and writes.
SEMANTIC_RESULT_CACHE_ENABLED="true"
# - Deterministic prefilter: shadow (default) only measures; enforce skips the
#   semantic call for confident unrelated domains. Deterministic providers and
#   the normal decision policy still run.
SEMANTIC_PREFILTER_MODE="shadow"
# SEMANTIC_PREFILTER_STALE_DAYS="730"
# SEMANTIC_PREFILTER_MIN_SUBSCRIBERS="50"
# - Batched semantics: opt-in coalescing of independent channel prompts into
#   one provider call. Keep off until shadow measurements justify it.
SEMANTIC_BATCH_CLASSIFICATION_ENABLED="false"
SEMANTIC_BATCH_MAX_SIZE="8"
# Must stay well under the stage-0 semantic attempt budget (2000ms aggregate
# per attempt). Raise only when quota, not latency, is the bottleneck.
SEMANTIC_BATCH_WINDOW_MS="400"
# Serialized batch-size budget (clamp 20000-400000). Oversized batches split
# before dispatch instead of failing every member as one provider call.
SEMANTIC_BATCH_MAX_PROMPT_CHARS="120000"
# - Per-account Gemini capacity (paid Gemini only). Each configured project has
#   its own pacing and rolling bucket; the legacy GEMINI_GLOBAL_MIN_INTERVAL_MS
#   name is honored when GEMINI_ORG_MIN_INTERVAL_MS is unset, and the interval
#   defaults to 6000ms. Uncomment to override.
# GEMINI_ORG_MIN_INTERVAL_MS="6000"
GEMINI_ORG_MAX_CALLS_PER_MINUTE="10"
GEMINI_ORG_RATE_WINDOW_MS="60000"
PROVIDER_TIMEOUT_ALERT_RATE="0.05"
PROVIDER_ERROR_ALERT_RATE="0.10"
# Percentage of autonomous searches assigned to video-first retrieval. The
# remainder uses channel-first retrieval; each run spends one 100-unit search.
DISCOVERY_VIDEO_LANE_PERCENT="70"

# Required for authenticated human-review reads and decisions.
REVIEW_API_TOKEN=""
# Optional single-operator defaults. When both are set, the Human Review UI
# hides its credential fields and the server applies these values automatically.
# If REVIEW_API_TOKEN is also set, DEFAULT_REVIEWER_API_TOKEN must match it.
DEFAULT_REVIEWER_API_TOKEN=""
DEFAULT_REVIEWER_IDENTITY=""

# Phase 1 operator boundary. ADMIN_API_TOKEN is required in production. During
# transition REVIEW_API_TOKEN is accepted with operator (not admin) privileges.
OPERATOR_API_TOKEN=""
OPERATOR_IDENTITY="operator"
ADMIN_API_TOKEN=""
ADMIN_IDENTITY="admin"
# Explicit local-only bypass; startup rejects this value in production.
OPERATOR_AUTH_BYPASS="false"
## Phase 5 passive ledger only. Set false to roll back shadow writes; this never
## enables research-program scheduling or changes the existing query scheduler.
PHASE5_SHADOW_WRITES=false
# Enables the immutable retrieval-boundary evaluation audit sample. Set a
# deployment-specific salt before enabling so assignments remain reproducible
# within a deployment without sharing the same sample across environments.
DECISION_EVALUATION_SAMPLING_SALT=
