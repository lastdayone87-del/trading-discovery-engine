{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test": "find server -name '*.test.ts' -exec node --import tsx --test {} +",
    "migrate": "tsx scripts/runMigrations.ts",
    "migrate:sqljs": "tsx scripts/migrateSqljsToPostgres.ts",
    "queue:smoke": "tsx scripts/queueSmokeTest.ts",
    "phase3:baseline": "tsx scripts/phase3Baseline.ts"
    ,"phase4:replay": "tsx scripts/phase4Replay.ts",
    "phase5:verify": "npm test && npm run lint && npm run build",
    "phase6:verify": "npm test && npm run lint && npm run build",
    "phase7:verify": "npm test && npm run lint && npm run build",
    "phase8:verify": "npm test && npm run lint && npm run build"
    ,"phase9:verify": "npm test && npm run lint && npm run build",
    "phase10:verify": "npm test && npm run lint && npm run build",
    "phase11:verify": "npm test && npm run lint && npm run build",
    "phase12:verify": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.1",
    "vite": "^6.2.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/pg": "^8.11.10"
  }
}
